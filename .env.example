# Copy this file to .env.local and fill in your own values. NEVER put real secrets in this file:
# it is committed to Git. Real values belong only in .env.local (ignored by Git) or in your host's secret store.

# TMDB (https://www.themoviedb.org/settings/api): the "API Read Access Token" (v4). Server-only.
TMDB_API_READ_ACCESS_TOKEN="your_tmdb_v4_read_access_token"
TMDB_LANGUAGE="fr-FR"

# Public Supabase project URL (not a secret, but yours: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# PostgreSQL via Supabase (Dashboard > Connect). Replace YOUR_DB_PASSWORD with your database password
# (URL-encode special characters) and remove the square brackets Supabase shows around it.
# Runtime: Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: Session pooler (port 5432); the direct db.<ref>.supabase.co host is IPv6-only
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Auth.js: generate your own with `openssl rand -base64 32`; use a different value per environment
AUTH_SECRET="generate_a_long_random_secret"
NEXTAUTH_URL="http://localhost:4028"

# Optional: dedicated server-side secret mixed into every profile PIN hash. When empty, AUTH_SECRET is used.
# Adding it later is safe: PINs hashed with AUTH_SECRET keep working and are upgraded at the next successful unlock.
# Once every PIN was unlocked at least once, you can set PIN_LEGACY_FALLBACK="off" to stop accepting the AUTH_SECRET hashes.
# When rotating PIN_PEPPER, put the old value in PIN_PEPPER_PREVIOUS until every PIN was unlocked again.
PIN_PEPPER=""
PIN_PEPPER_PREVIOUS=""
PIN_LEGACY_FALLBACK=""

# Optional: contact address shown in the Help Center ("Écrire au support"). Leave empty until a mailbox exists:
# the Help Center then says plainly that message support is not available yet. Public value, read at build time.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Keep false until an authorized playback source exists
AUTHORIZED_PLAYBACK_ENABLED="false"

# TMDB artwork: "direct" (default) loads pre-sized images straight from the TMDB CDN; "optimized" routes them
# through the Next.js image optimizer (smaller AVIF/WebP, but a server-side fetch with a fixed 7s limit).
NEXT_PUBLIC_TMDB_IMAGE_MODE="direct"

# Optional: how many state-changing requests one support administrator may make per minute (default 90).
# SUPPORT_ADMIN_MUTATIONS_PER_MINUTE="90"
